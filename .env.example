# Kredensial Login Administrator
ADMIN_USERNAME=teamowee
ADMIN_PASSWORD=12345678

# Token Secret (Minimal 32 Karakter)
SESSION_SECRET=team_oweee_muaythai_secret_jwt_key_2026_super_secure_hash

# PostgreSQL Database URL (Vercel Postgres / Neon / Supabase / Railway)
# Jika disetel di Vercel Environment Variables, data atlet akan disimpan permanen di database PostgreSQL
# dan tidak akan pernah ter-reset saat serverless restart/cold start.
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require
# ATAU (Otomatis jika menggunakan Vercel Postgres Integration):
POSTGRES_URL=
